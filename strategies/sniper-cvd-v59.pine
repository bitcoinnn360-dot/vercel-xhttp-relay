//=============================================================================
div_prd          = input.int(10, title="پریود پیوت واگرایی (Pivot Period)", minval=1, maxval=50, group="تنظیمات سیگنال طلایی")
div_source       = input.string("Close", title="منبع پیوت‌ها", options=["Close", "High/Low"], group="تنظیمات سیگنال طلایی")
