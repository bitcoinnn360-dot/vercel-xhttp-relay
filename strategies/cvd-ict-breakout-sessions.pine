    s2_low := low
    s2_active := false
    s2_sweep_high_active := false
    s2_sweep_low_active := false
    s2_lqr_high_active := false
    s2_lqr_high_fvg_active := false
    s2_lqr_low_active := false
    s2_lqr_low_fvg_active := false
    s2_lqr_high_triggered := false
    s2_lqr_low_triggered := false
    s2_lqr_high_executed := false
    s2_lqr_low_executed := false
    if show_sessions
        s2_box := box.new(left=s2_start, top=s2_high, right=bar_index, bottom=s2_low, bgcolor=col_sess2, border_color=color.new(col_sess2, 10), border_width=1, text="S2 (06-12)", text_color=color.white, text_size=size.small, text_valign=text.align_top, text_halign=text.align_left)

if in_s2
    s2_high := math.max(s2_high, high)
    s2_low := math.min(s2_low, low)
    if show_sessions
        box.set_top(s2_box, s2_high)
        box.set_bottom(s2_box, s2_low)
        box.set_right(s2_box, bar_index)

if is_s2_end
    s2_active := true

if s2_active and show_sessions
    box.set_right(s2_box, bar_index)
    if high > s2_high
        s2_active := false
        s2_sweep_high_active := true
        s2_sweep_high_bar := bar_index
        s2_h_swept := true
        box.set_border_style(s2_box, line.style_dashed)
        box.set_bgcolor(s2_box, color.new(color.gray, 95))
     
    else if low < s2_low
        s2_active := false
        s2_sweep_low_active := true
        s2_sweep_low_bar := bar_index
        s2_l_swept := true
        box.set_border_style(s2_box, line.style_dashed)
        box.set_bgcolor(s2_box, color.new(color.gray, 95))
       
if s2_sweep_high_active and show_sweep_strat
    if (bar_index - s2_sweep_high_bar) > allowed_bars
        s2_sweep_high_active := false
    else if close < s2_high
        bool is_ifvg_detected = ifvg_outside_only ? detect_bear_ifvg_outside(s2_high, s2_sweep_high_bar) : detect_recent_bear_ifvg()
        if is_ifvg_detected or detect_bear_fvg_returning(s2_high, s2_sweep_high_bar)
            s2_sweep_sell := true
            s2_sweep_high_active := false
            label.new(x=bar_index, y=high, text="S2 SW 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if s2_sweep_low_active and show_sweep_strat
    if (bar_index - s2_sweep_low_bar) > allowed_bars
        s2_sweep_low_active := false
    else if close > s2_low
        bool is_ifvg_detected = ifvg_outside_only ? detect_bull_ifvg_outside(s2_low, s2_sweep_low_bar) : detect_recent_bull_ifvg()
        if is_ifvg_detected or detect_bull_fvg_returning(s2_low, s2_sweep_low_bar)
            s2_sweep_buy := true
            s2_sweep_low_active := false
            label.new(x=bar_index, y=low, text="S2 SW 🟢", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// پایش ران نقدینگی سشن ۲
if not in_s2 and not na(s2_high) and not s2_lqr_high_triggered and not s2_lqr_high_executed
    if close > s2_high and close > open
        s2_lqr_high_active := true
        s2_lqr_high_triggered := true
        s2_lqr_high_trigger_bar := bar_index

if s2_lqr_high_active and show_lqr_strat
    if (bar_index - s2_lqr_high_trigger_bar) > lqr_wait_bars
        s2_lqr_high_active := false
        s2_lqr_high_triggered := false
    else
        lqr_gap_s2 = low - high[2]
        lqr_body_s2 = math.abs(close[1] - open[1])
        lqr_size_2_s2 = high[1] - low[1]
        lqr_size_1_s2 = high[2] - low[2]
        lqr_size_3_s2 = high - low
        lqr_avg_1_3_s2 = (lqr_size_1_s2 + lqr_size_3_s2) / 2.0
        lqr_is_displaced_s2 = lqr_size_2_s2 >= (lqr_avg_1_3_s2 * lqr_displacement_mult)
        lqr_color_ok_s2 = close[1] > open[1] and (lqr_is_displaced_s2 or close > open)
        
        if low > high[2] and low > s2_high and lqr_color_ok_s2 and lqr_gap_s2 >= (lqr_body_s2 * (fvg_body_pct / 100.0))
            s2_lqr_high_active := false
            s2_lqr_high_fvg_active := true
            s2_lqr_high_fvg_top := low
            s2_lqr_high_fvg_bottom := high[2]

if s2_lqr_high_fvg_active and show_lqr_strat
    if low <= s2_lqr_high_fvg_top and close >= s2_lqr_high_fvg_bottom
        s2_lqr_buy_sig := true
        s2_lqr_high_fvg_active := false
        s2_lqr_high_executed := true
        label.new(x=bar_index, y=low, text="S2 LQR 🔵", color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.tiny)
    else if close < s2_lqr_high_fvg_bottom
        s2_lqr_rev_sell_sig := true
        s2_lqr_high_fvg_active := false
        s2_lqr_high_executed := true
        label.new(x=bar_index, y=high, text="S2 LQR- 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if not in_s2 and not na(s2_low) and not s2_lqr_low_triggered and not s2_lqr_low_executed
    if close < s2_low and close < open
        s2_lqr_low_active := true
        s2_lqr_low_triggered := true
        s2_lqr_low_trigger_bar := bar_index

if s2_lqr_low_active and show_lqr_strat
    if (bar_index - s2_lqr_low_trigger_bar) > lqr_wait_bars
        s2_lqr_low_active := false
        s2_lqr_low_triggered := false
    else
        lqr_gap_s2_low = high < low[2] ? low[2] - high : 0.0
        lqr_body_s2_low = math.abs(close[1] - open[1])
        lqr_size_2_s2_low = high[1] - low[1]
        lqr_size_1_s2_low = high[2] - low[2]
        lqr_size_3_s2_low = high - low
        lqr_avg_1_3_s2_low = (lqr_size_1_s2_low + lqr_size_3_s2_low) / 2.0
        lqr_is_displaced_s2_low = lqr_size_2_s2_low >= (lqr_avg_1_3_s2_low * lqr_displacement_mult)
        lqr_color_ok_s2_low = close[1] < open[1] and (lqr_is_displaced_s2_low or close < open)
        
        if high < low[2] and high < s2_low and lqr_color_ok_s2_low and lqr_gap_s2_low >= (lqr_body_s2_low * (fvg_body_pct / 100.0))
            s2_lqr_low_active := false
            s2_lqr_low_fvg_active := true
            s2_lqr_low_fvg_top := low[2]
            s2_lqr_low_fvg_bottom := high

if s2_lqr_low_fvg_active and show_lqr_strat
    if high >= s2_lqr_low_fvg_bottom and close <= s2_lqr_low_fvg_top
        s2_lqr_sell_sig := true
        s2_lqr_low_fvg_active := false
        s2_lqr_low_executed := true
        label.new(x=bar_index, y=high, text="S2 LQR 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)
    else if close > s2_lqr_low_fvg_top
        s2_lqr_rev_buy_sig := true
        s2_lqr_low_fvg_active := false
        s2_lqr_low_executed := true
        label.new(x=bar_index, y=low, text="S2 LQR- 🟢", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// سشن ۳ (12:00 - 18:00)
is_s3_start = in_s3 and (not in_s3[1] or na(in_s3[1]))
is_s3_end = not in_s3 and in_s3[1]

if is_s3_start
    s3_start := bar_index
    s3_high := high
    s3_low := low
    s3_active := false
    s3_sweep_high_active := false
    s3_sweep_low_active := false
    s3_lqr_high_active := false
    s3_lqr_high_fvg_active := false
    s3_lqr_low_active := false
    s3_lqr_low_fvg_active := false
    s3_lqr_high_triggered := false
    s3_lqr_low_triggered := false
    s3_lqr_high_executed := false
    s3_lqr_low_executed := false
    if show_sessions
        s3_box := box.new(left=s3_start, top=s3_high, right=bar_index, bottom=s3_low, bgcolor=col_sess3, border_color=color.new(col_sess3, 10), border_width=1, text="S3 (12-18)", text_color=color.white, text_size=size.small, text_valign=text.align_top, text_halign=text.align_left)

if in_s3
