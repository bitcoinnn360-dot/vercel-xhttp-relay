w1_price_thresh = input.float(0.02, title="حداقل شیب قیمت W1 شارپ (%)", step=0.01, group="ریگلاژ اختصاصی امواج SW")
w1_cvd_thresh = input.float(5.0, title="حداقل شیب حجم W1 شارپ", minval=0.0, maxval=50.0, step=0.5, group="ریگلاژ اختصاصی امواج SW")

// کنترل بازه عددی اصلاح قیمت و حجم در ستاپ امواج SW (حذف کامل حداقل اصلاح CVD)
min_price_retracement = input.float(20.0, title="حداقل درصد اصلاح مجاز قیمت موج ۲", minval=0.0, maxval=100.0, step=5.0, group="اصلاح تنظیمات (Correction)") / 100.0
max_price_retracement = input.float(50.0, title="حداکثر درصد اصلاح مجاز قیمت موج ۲", minval=10.0, maxval=100.0, step=5.0, group="اصلاح تنظیمات (Correction)") / 100.0
max_cvd_retracement   = input.float(50.0, title="حداکثر درصد اصلاح مجاز حجم (CVD) موج ۲", minval=10.0, maxval=100.0, step=5.0, group="اصلاح تنظیمات (Correction)")

//=============================================================================
