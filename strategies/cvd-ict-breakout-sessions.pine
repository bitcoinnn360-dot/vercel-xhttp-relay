    s3_low := math.min(s3_low, low)
    if show_sessions
        box.set_top(s3_box, s3_high)
        box.set_bottom(s3_box, s3_low)
        box.set_right(s3_box, bar_index)

if is_s3_end
    s3_active := true

if s3_active and show_sessions
    box.set_right(s3_box, bar_index)
    if high > s3_high
        s3_active := false
        s3_sweep_high_active := true
        s3_sweep_high_bar := bar_index
        s3_h_swept := true
        box.set_border_style(s3_box, line.style_dashed)
        box.set_bgcolor(s3_box, color.new(color.gray, 95))
 
    else if low < s3_low
        s3_active := false
        s3_sweep_low_active := true
        s3_sweep_low_bar := bar_index
        s3_l_swept := true
        box.set_border_style(s3_box, line.style_dashed)
        box.set_bgcolor(s3_box, color.new(color.gray, 95))

// پایش سوییپ زمان‌بند سشن ۳
if s3_sweep_high_active and show_sweep_strat
    if (bar_index - s3_sweep_high_bar) > allowed_bars
        s3_sweep_high_active := false
    else if close < s3_high
        bool is_ifvg_detected = ifvg_outside_only ? detect_bear_ifvg_outside(s3_high, s3_sweep_high_bar) : detect_recent_bear_ifvg()
        if is_ifvg_detected or detect_bear_fvg_returning(s3_high, s3_sweep_high_bar)
            s3_sweep_sell := true
            s3_sweep_high_active := false
            label.new(x=bar_index, y=high, text="S3 SW 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if s3_sweep_low_active and show_sweep_strat
    if (bar_index - s3_sweep_low_bar) > allowed_bars
        s3_sweep_low_active := false
    else if close > s3_low
        bool is_ifvg_detected = ifvg_outside_only ? detect_bull_ifvg_outside(s3_low, s3_sweep_low_bar) : detect_recent_bull_ifvg()
        if is_ifvg_detected or detect_bull_fvg_returning(s3_low, s3_sweep_low_bar)
            s3_sweep_buy := true
            s3_sweep_low_active := false
            label.new(x=bar_index, y=low, text="S3 SW 🟢", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// پایش ران نقدینگی سشن ۳
if not in_s3 and not na(s3_high) and not s3_lqr_high_triggered and not s3_lqr_high_executed
    if close > s3_high and close > open
        s3_lqr_high_active := true
        s3_lqr_high_triggered := true
        s3_lqr_high_trigger_bar := bar_index

if s3_lqr_high_active and show_lqr_strat
    if (bar_index - s3_lqr_high_trigger_bar) > lqr_wait_bars
        s3_lqr_high_active := false
        s3_lqr_high_triggered := false
    else
        lqr_gap_s3 = low - high[2]
        lqr_body_s3 = math.abs(close[1] - open[1])
        lqr_size_2_s3 = high[1] - low[1]
        lqr_size_1_s3 = high[2] - low[2]
        lqr_size_3_s3 = high - low
        lqr_avg_1_3_s3 = (lqr_size_1_s3 + lqr_size_3_s3) / 2.0
        lqr_is_displaced_s3 = lqr_size_2_s3 >= (lqr_avg_1_3_s3 * lqr_displacement_mult)
        lqr_color_ok_s3 = close[1] > open[1] and (lqr_is_displaced_s3 or close > open)
        
        if low > high[2] and low > s3_high and lqr_color_ok_s3 and lqr_gap_s3 >= (lqr_body_s3 * (fvg_body_pct / 100.0))
            s3_lqr_high_active := false
            s3_lqr_high_fvg_active := true
            s3_lqr_high_fvg_top := low
            s3_lqr_high_fvg_bottom := high[2]

if s3_lqr_high_fvg_active and show_lqr_strat
    if low <= s3_lqr_high_fvg_top and close >= s3_lqr_high_fvg_bottom
        s3_lqr_buy_sig := true
        s3_lqr_high_fvg_active := false
        s3_lqr_high_executed := true
        label.new(x=bar_index, y=low, text="S3 LQR 🔵", color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.tiny)
    else if close < s3_lqr_high_fvg_bottom
        s3_lqr_rev_sell_sig := true
        s3_lqr_high_fvg_active := false
        s3_lqr_high_executed := true
        label.new(x=bar_index, y=high, text="S3 LQR- 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if not in_s3 and not na(s3_low) and not s3_lqr_low_triggered and not s3_lqr_low_executed
    if close < s3_low and close < open
        s3_lqr_low_active := true
        s3_lqr_low_triggered := true
        s3_lqr_low_trigger_bar := bar_index

if s3_lqr_low_active and show_lqr_strat
    if (bar_index - s3_lqr_low_trigger_bar) > lqr_wait_bars
        s3_lqr_low_active := false
        s3_lqr_low_triggered := false
    else
        lqr_gap_s3_low = high < low[2] ? low[2] - high : 0.0
        lqr_body_s3_low = math.abs(close[1] - open[1])
        lqr_size_2_s3_low = high[1] - low[1]
        lqr_size_1_s3_low = high[2] - low[2]
        lqr_size_3_s3_low = high - low
        lqr_avg_1_3_s3_low = (lqr_size_1_s3_low + lqr_size_3_s3_low) / 2.0
        lqr_is_displaced_s3_low = lqr_size_2_s3_low >= (lqr_avg_1_3_s3_low * lqr_displacement_mult)
        lqr_color_ok_s3_low = close[1] < open[1] and (lqr_is_displaced_s3_low or close < open)
        
        if high < low[2] and high < s3_low and lqr_color_ok_s3_low and lqr_gap_s3_low >= (lqr_body_s3_low * (fvg_body_pct / 100.0))
            s3_lqr_low_active := false
            s3_lqr_low_fvg_active := true
            s3_lqr_low_fvg_top := low[2]
            s3_lqr_low_fvg_bottom := high

if s3_lqr_low_fvg_active and show_lqr_strat
    if high >= s3_lqr_low_fvg_bottom and close <= s3_lqr_low_fvg_top
        s3_lqr_sell_sig := true
        s3_lqr_low_fvg_active := false
        s3_lqr_low_executed := true
        label.new(x=bar_index, y=high, text="S3 LQR 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)
    else if close > s3_lqr_low_fvg_top
        s3_lqr_rev_buy_sig := true
        s3_lqr_low_fvg_active := false
        s3_lqr_low_executed := true
        label.new(x=bar_index, y=low, text="S3 LQR- 🟢", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// سشن ۴ (آسیا 18:00 - 00:00)
is_s4_start = in_s4 and (not in_s4[1] or na(in_s4[1]))
is_s4_end = not in_s4 and in_s4[1]

if is_s4_start
    s4_start := bar_index
    s4_high := high
    s4_low := low
    s4_active := false
    s4_sweep_high_active := false
    s4_sweep_low_active := false
    s4_lqr_high_active := false
    s4_lqr_high_fvg_active := false
    s4_lqr_low_active := false
    s4_lqr_low_fvg_active := false
    s4_lqr_high_triggered := false
    s4_lqr_low_triggered := false
    s4_lqr_high_executed := false
    s4_lqr_low_executed := false
    if show_sessions
        s4_box := box.new(left=s4_start, top=s4_high, right=bar_index, bottom=s4_low, bgcolor=col_sess4, border_color=color.new(col_sess4, 10), border_width=1, text="S4 (18-00)", text_color=color.white, text_size=size.small, text_valign=text.align_top, text_halign=text.align_left)

if in_s4
    s4_high := math.max(s4_high, high)
    s4_low := math.min(s4_low, low)
    if show_sessions
        box.set_top(s4_box, s4_high)
        box.set_bottom(s4_box, s4_low)
        box.set_right(s4_box, bar_index)

if is_s4_end
    s4_active := true

if s4_active and show_sessions
    box.set_right(s4_box, bar_index)
    if high > s4_high
        s4_active := false
        s4_sweep_high_active := true
        s4_sweep_high_bar := bar_index
        s4_h_swept := true
        box.set_border_style(s4_box, line.style_dashed)
        box.set_bgcolor(s4_box, color.new(color.gray, 95))
 
    else if low < s4_low
        s4_active := false
        s4_sweep_low_active := true
        s4_sweep_low_bar := bar_index
        s4_l_swept := true
        box.set_border_style(s4_box, line.style_dashed)
        box.set_bgcolor(s4_box, color.new(color.gray, 95))
 
if s4_sweep_high_active and show_sweep_strat
    if (bar_index - s4_sweep_high_bar) > allowed_bars
        s4_sweep_high_active := false
    else if close < s4_high
        bool is_ifvg_detected = ifvg_outside_only ? detect_bear_ifvg_outside(s4_high, s4_sweep_high_bar) : detect_recent_bear_ifvg()
        if is_ifvg_detected or detect_bear_fvg_returning(s4_high, s4_sweep_high_bar)
            s4_sweep_sell := true
            s4_sweep_high_active := false
            label.new(x=bar_index, y=high, text="S4 SW 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if s4_sweep_low_active and show_sweep_strat
    if (bar_index - s4_sweep_low_bar) > allowed_bars
        s4_sweep_low_active := false
    else if close > s4_low
        bool is_ifvg_detected = ifvg_outside_only ? detect_bull_ifvg_outside(s4_low, s4_sweep_low_bar) : detect_recent_bull_ifvg()
        if is_ifvg_detected or detect_bull_fvg_returning(s4_low, s4_sweep_low_bar)
            s4_sweep_buy := true
            s4_sweep_low_active := false
            label.new(x=bar_index, y=low, text="S4 SW 🟢", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)

// پایش ران نقدینگی سشن ۴
if not in_s4 and not na(s4_high) and not s4_lqr_high_triggered and not s4_lqr_high_executed
    if close > s4_high and close > open
        s4_lqr_high_active := true
        s4_lqr_high_triggered := true
        s4_lqr_high_trigger_bar := bar_index

if s4_lqr_high_active and show_lqr_strat
    if (bar_index - s4_lqr_high_trigger_bar) > lqr_wait_bars
        s4_lqr_high_active := false
        s4_lqr_high_triggered := false
    else
        lqr_gap_s4 = low - high[2]
        lqr_body_s4 = math.abs(close[1] - open[1])
        lqr_size_2_s4 = high[1] - low[1]
        lqr_size_1_s4 = high[2] - low[2]
        lqr_size_3_s4 = high - low
        lqr_avg_1_3_s4 = (lqr_size_1_s4 + lqr_size_3_s4) / 2.0
        lqr_is_displaced_s4 = lqr_size_2_s4 >= (lqr_avg_1_3_s4 * lqr_displacement_mult)
        lqr_color_ok_s4 = close[1] > open[1] and (lqr_is_displaced_s4 or close > open)
        
        if low > high[2] and low > s4_high and lqr_color_ok_s4 and lqr_gap_s4 >= (lqr_body_s4 * (fvg_body_pct / 100.0))
            s4_lqr_high_active := false
            s4_lqr_high_fvg_active := true
            s4_lqr_high_fvg_top := low
            s4_lqr_high_fvg_bottom := high[2]

if s4_lqr_high_fvg_active and show_lqr_strat
    if low <= s4_lqr_high_fvg_top and close >= s4_lqr_high_fvg_bottom
        s4_lqr_buy_sig := true
        s4_lqr_high_fvg_active := false
        s4_lqr_high_executed := true
        label.new(x=bar_index, y=low, text="S4 LQR 🔵", color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.tiny)
    else if close < s4_lqr_high_fvg_bottom
        s4_lqr_rev_sell_sig := true
        s4_lqr_high_fvg_active := false
        s4_lqr_high_executed := true
        label.new(x=bar_index, y=high, text="S4 LQR- 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

if not in_s4 and not na(s4_low) and not s4_lqr_low_triggered and not s4_lqr_low_executed
    if close < s4_low and close < open
        s4_lqr_low_active := true
        s4_lqr_low_triggered := true
        s4_lqr_low_trigger_bar := bar_index

if s4_lqr_low_active and show_lqr_strat
    if (bar_index - s4_lqr_low_trigger_bar) > lqr_wait_bars
        s4_lqr_low_active := false
        s4_lqr_low_triggered := false
    else
        lqr_gap_s4_low = high < low[2] ? low[2] - high : 0.0
        lqr_body_s4_low = math.abs(close[1] - open[1])
        lqr_size_2_s4_low = high[1] - low[1]
        lqr_size_1_s4_low = high[2] - low[2]
        lqr_size_3_s4_low = high - low
        lqr_avg_1_3_s4_low = (lqr_size_1_s4_low + lqr_size_3_s4_low) / 2.0
        lqr_is_displaced_s4_low = lqr_size_2_s4_low >= (lqr_avg_1_3_s4_low * lqr_displacement_mult)
        lqr_color_ok_s4_low = close[1] < open[1] and (lqr_is_displaced_s4_low or close < open)
        
        if high < low[2] and high < s4_low and lqr_color_ok_s4_low and lqr_gap_s4_low >= (lqr_body_s4_low * (fvg_body_pct / 100.0))
            s4_lqr_low_active := false
            s4_lqr_low_fvg_active := true
            s4_lqr_low_fvg_top := low[2]
            s4_lqr_low_fvg_bottom := high

if s4_lqr_low_fvg_active and show_lqr_strat
    if high >= s4_lqr_low_fvg_bottom and close <= s4_lqr_low_fvg_top
        s4_lqr_sell_sig := true
        s4_lqr_low_fvg_active := false
        s4_lqr_low_executed := true
        label.new(x=bar_index, y=high, text="S4 LQR 🔴", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)
    else if close > s4_lqr_low_fvg_top
        s4_lqr_rev_buy_sig := true
        s4_lqr_low_fvg_active := false
        s4_lqr_low_executed := true
        label.new(x=bar_index, y=low, text="S4 LQR- 🟢", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.tiny)

//=============================================================================
// ۱۰. شکست FVG متغیرهای ثبت پویا و رسم باکس‌های کامل (نسخه اصلی درخواست شما)
//=============================================================================
var box bull_fvg_box = na
var float bull_fvg_top = na
var float bull_fvg_bottom = na
var bool bull_fvg_active = false

var box bear_fvg_box = na
var float bear_fvg_top = na
var float bear_fvg_bottom = na
var bool bear_fvg_active = false

//=============================================================================
// ۱۱. منطق شکست سقف با FVG (Bullish BOS + FVG)
//=============================================================================
bool bull_fvg_detected = low > high[2]

// شرط قرارگیری سوئینگ سقف در دل FVG + بررسی وجود FVG صعودی کاملاً بکر در محدوده قیمتی موج صعودی ساخته شده
bool has_target_fvg_bull = has_active_bull_fvg_below(last_sw_low, last_sw_high)
bool bull_bsg_breakout = bull_fvg_detected and (last_sw_high > high[2] and last_sw_high < low) and has_target_fvg_bull

if bull_bsg_breakout
    bull_fvg_top := low
    bull_fvg_bottom := high[2]
    bull_fvg_active := true
    // ترسیم مجدد باکس کامل نسخه اول (درخواست شما)
    bull_fvg_box := box.new(left=bar_index - 2, top=bull_fvg_top, right=bar_index, bottom=bull_fvg_bottom, bgcolor=col_bull_fvg, border_color=color.new(color.green, 50))
    label.new(x=bar_index, y=high, text="BSG", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.tiny)

// پایش صعودی باکس جهت REVERSAL
if bull_fvg_active
    box.set_right(bull_fvg_box, bar_index)
    if close < bull_fvg_bottom
        bull_fvg_active := false
        box.set_bgcolor(bull_fvg_box, color.new(color.red, 95))
        box.set_border_style(bull_fvg_box, line.style_dashed)
        label.new(x=bar_index, y=low, text="REV", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.tiny)

//=============================================================================
// ۱۲. منطق شکست کف با FVG (Bearish BOS + FVG)
//=============================================================================
bool bear_fvg_detected = high < low[2]

// شرط سوئینگ کف در دل FVG + بررسی وجود FVG نزولی کاملاً بکر در طول همان موج نزولی ساخته شده
bool has_target_fvg_bear = has_active_bear_fvg_above(last_sw_low, last_sw_high)
bool bear_bsg_breakout = bear_fvg_detected and (last_sw_low < low[2] and last_sw_low > high) and has_target_fvg_bear

if bear_bsg_breakout
    bear_fvg_top := low[2]
    bear_fvg_bottom := high
    bear_fvg_active := true
    // ترسیم مجدد باکس کامل نسخه اول (درخواست شما)
    bear_fvg_box := box.new(left=bar_index - 2, top=bear_fvg_top, right=bar_index, bottom=bear_fvg_bottom, bgcolor=col_bear_fvg, border_color=color.new(color.red, 50))
    label.new(x=bar_index, y=low, text="BSG", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.tiny)

// پایش نزولی باکس جهت REVERSAL
if bear_fvg_active
    box.set_right(bear_fvg_box, bar_index)
    if close > bear_fvg_top
        bear_fvg_active := false
        box.set_bgcolor(bear_fvg_box, color.new(color.green, 95))
        box.set_border_style(bear_fvg_box, line.style_dashed)
        label.new(x=bar_index, y=high, text="REV", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.tiny)

//=============================================================================
// ۱۳. ثبت هشدارهای معاملاتی استراتژی شکست و سوییپ و ران نقدینگی
//=============================================================================
bool any_sweep_buy = s1_sweep_buy or s2_sweep_buy or s3_sweep_buy or s4_sweep_buy or pdl_sweep_trigger or pdl_sweep_buy
bool any_sweep_sell = s1_sweep_sell or s2_sweep_sell or s3_sweep_sell or s4_sweep_sell or pdh_sweep_trigger or pdh_sweep_sell
bool any_lqr_buy = s1_lqr_buy_sig or s1_lqr_rev_buy_sig or s2_lqr_buy_sig or s2_lqr_rev_buy_sig or s3_lqr_buy_sig or s3_lqr_rev_buy_sig or s4_lqr_buy_sig or s4_lqr_rev_buy_sig
bool any_lqr_sell = s1_lqr_sell_sig or s1_lqr_rev_sell_sig or s2_lqr_sell_sig or s2_lqr_rev_sell_sig or s3_lqr_sell_sig or s3_lqr_rev_sell_sig or s4_lqr_sell_sig or s4_lqr_rev_sell_sig

alertcondition(bull_bsg_breakout, title="BOS Bullish with FVG", message="شکست سقف ساختاری با جابجایی تایید شد.")
alertcondition(bear_bsg_breakout, title="BOS Bearish with FVG", message="شکست کف ساختاری با جابجایی تایید شد.")
alertcondition(any_sweep_buy, title="ICT Sweep Buy Signal", message="نقدینگی کف شکار شد و برگشت خرید تایید گردید.")
alertcondition(any_sweep_sell, title="ICT Sweep Sell Signal", message="نقدینگی سقف شکار شد و برگشت فروش تایید گردید.")
alertcondition(any_lqr_buy, title="ICT LQR Buy Signal", message="سیگنال صعودی لکوئیدیتی ران صادر شد.")
alertcondition(any_lqr_sell, title="ICT LQR Sell Signal", message="سیگنال نزولی لکوئیدیتی ران صادر شد.")
